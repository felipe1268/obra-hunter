# ==================== ObraHunter ====================
# Copie este arquivo para .env e preencha as variáveis

# App
DEBUG=true
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/obrahunter
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/obrahunter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=obrahunter

# Redis
REDIS_URL=redis://redis:6379/0

# Google Maps API (obrigatório para scraper de Google Maps)
# Crie em: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Google Custom Search API (opcional, para buscas em diários oficiais)
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=

# Scheduler
SCHEDULER_ENABLED=true
BUSCA_DIARIA_HORA=6
BUSCA_CONTINUA_INTERVALO_MIN=30

# Score mínimo para gerar alerta (0-10)
SCORE_THRESHOLD_ALERTA=7.0

# Email (SMTP para alertas)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Webhook (Slack, Discord, Zapier, etc.)
ALERT_WEBHOOK_URL=

# WhatsApp Business API (opcional)
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
